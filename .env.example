# OCR_MODEL_DIR=../finmme_reproduction/path/to/ocr_models
# FINMME_RECORDS_PATH=../finmme_reproduction/path/to/full_records.jsonl
# PROJECT_ROOT=.
# OMP_NUM_THREADS=6
# MKL_NUM_THREADS=6
