# Required: existing FinMME reproduction workspace (not included in this repo).
FINMME_ROOT=../finmme_reproduction

# Optional overrides. Defaults are resolved relative to FINMME_ROOT.
# PYTHON_BIN=../finmme_reproduction/path/to/python
# OCR_MODEL_DIR=../finmme_reproduction/path/to/ocr_models
# FINMME_RECORDS_PATH=../finmme_reproduction/path/to/full_records.jsonl
# RAW_VLM_PATH=../finmme_reproduction/path/to/qwen25vl7b_direct_full.jsonl
# CANDIDATE_SCAN_PATH=./audit/candidate_scan_v3.jsonl
# CALIBRATOR_PATH=./config/calibrator_model.json
# PROJECT_ROOT=.
# OMP_NUM_THREADS=6
# MKL_NUM_THREADS=6
# PHASE2_MAX_SAMPLES=50
# PHASE2_MAX_NEW_CHARTS=180
# PHASE2_BOOTSTRAP_ITERATIONS=10000
